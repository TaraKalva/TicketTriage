# Copy this file to .env and fill in what you have.
# If no key is set, the triage engine falls back to a built-in
# rule-based classifier so the app still works end-to-end without any AI key.
#
# Provider priority when multiple keys are set: Gemini -> Anthropic -> OpenAI -> rule-based fallback.

# Preferred (free): Google Gemini. Get a free API key at https://aistudio.google.com/apikey
# Defaults to gemini-2.5-flash, which is free-tier eligible. Avoid switching to a Pro model
# here unless you have billing enabled — Pro models are not covered by the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative: Anthropic (Claude)
ANTHROPIC_API_KEY=

# Alternative: OpenAI
OPENAI_API_KEY=

PORT=4000

# Confidence (0-1) below which a triaged ticket is sent to the human review queue
CONFIDENCE_THRESHOLD=0.7
